# The source jar (140 MB). tools/extract.mjs downloads it again (URL and SHA-512 are in tools/extract.config.json).
Cobblemon-fabric-1.8.4+1.21.1.jar

# Third-party jars and the Cobblemon source checkout used by tools/port-posers.mjs
/vendor

# Generated by tools/extract.mjs (assets, CSVs, icons, card art) and by the tools' reports. Rebuild with: node tools/extract.mjs
# (tools/ported-posers/ is NOT ignored on purpose: it can be fixed by hand and is tracked.)
/resources
/build

# Older working copy of the extraction; no longer needed
/extracted

# Gradle, IDE and Minecraft dev-run output (Mod, Core, API). Also covers the mod folder after its rename from PokeDnD/ to Mod/.
**/.gradle/
**/build/
/PokeDnD/run/
/Mod/run/
.idea/
*.iml

# npm / Angular output (App)
node_modules/
.angular/
/App/dist/
/App/test-results/
/App/playwright-report/

# Secrets and logs (deploy/.env.example stays tracked)
.env
*.log
