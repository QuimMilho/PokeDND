# PokeDnD — settings for Docker Compose (spec chapter 13.5).
#
#   cp deploy/.env.example deploy/.env      then fill in every CHANGE_ME
#
# deploy/.env is ignored by git and holds your secrets. This example file is tracked and holds none:
# every secret below is the word CHANGE_ME. Never put a real password or key in this file.
# Do not put quotes around values and do not leave spaces around "=".

# ---------------------------------------------------------------------------
# What to start
# ---------------------------------------------------------------------------

# Which services run. Pick ONE database: postgres | mysql | mariadb | mongo.
# Add "dev" for mailpit (a fake mail server) and "minecraft" for a test Minecraft server.
# Only postgres has an API image today (the others come in phase 34).
COMPOSE_PROFILES=postgres

# Public address of the site, without https://. Caddy gets the HTTPS certificate for it.
# "localhost" is fine for trying things on your own machine.
POKEDND_DOMAIN=localhost

# The API and app images ("owner" stands for the GitHub account that publishes them, in lowercase). Leave as is to build them here (docker compose build) or pull them from the registry.
# Use the matching image for your database, e.g. ghcr.io/owner/pokednd-api:latest-mysql
POKEDND_APP_IMAGE=ghcr.io/owner/pokednd-app:latest
POKEDND_API_IMAGE=ghcr.io/owner/pokednd-api:latest-postgres

# ---------------------------------------------------------------------------
# Database (shared by the database container and the API)
# ---------------------------------------------------------------------------

# Name, user and password of the database that the db container creates on first start.
DB_NAME=pokednd
DB_USER=pokednd
# Choose a long random password, e.g.: openssl rand -base64 24   (letters and digits are safest)
DB_PASSWORD=CHANGE_ME

# How the API reaches the database. Quarkus reads these three variables by name.
# PostgreSQL (default):
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://db:5432/pokednd
# MySQL:   jdbc:mysql://db-mysql:3306/pokednd       MariaDB: jdbc:mariadb://db-mariadb:3306/pokednd
QUARKUS_DATASOURCE_USERNAME=${DB_USER}
QUARKUS_DATASOURCE_PASSWORD=${DB_PASSWORD}
# MongoDB uses this single line instead of the three above (phase 34):
# QUARKUS_MONGODB_CONNECTION_STRING=mongodb://pokednd:CHANGE_ME@db-mongo:27017/pokednd?authSource=admin

# ---------------------------------------------------------------------------
# The API
# ---------------------------------------------------------------------------

# Public URL of the app. Used in e-mail links and OAuth callbacks. Must match POKEDND_DOMAIN.
POKEDND_BASE_URL=https://localhost

# Keys that sign the login tokens. Create a pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste each file as ONE line with the line breaks written as \n. (Phase 22 fixes the exact format.)
POKEDND_JWT_PRIVATE_KEY=CHANGE_ME
POKEDND_JWT_PUBLIC_KEY=CHANGE_ME

# The first site admin, created on first start when no admin exists yet. Change the password after logging in.
POKEDND_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
POKEDND_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Sign in with Discord. Create an application at https://discord.com/developers/applications and set its
# redirect URL to <POKEDND_BASE_URL>/api/v1/auth/discord/callback. Leave empty to switch Discord sign-in off.
POKEDND_OAUTH_DISCORD_CLIENT_ID=
POKEDND_OAUTH_DISCORD_CLIENT_SECRET=

# Mail server for e-mail verification and password reset.
# With the "dev" profile use the values below: mails appear at http://localhost:8025 and go nowhere else.
POKEDND_SMTP_HOST=mailpit
POKEDND_SMTP_PORT=1025
POKEDND_SMTP_USER=
POKEDND_SMTP_PASSWORD=
POKEDND_SMTP_FROM=PokeDnD <no-reply@localhost>
# true = encrypt the connection (use it with a real mail server)
POKEDND_SMTP_TLS=false

# Web Push keys (phase 75). Create a pair with: npx web-push generate-vapid-keys
# POKEDND_VAPID_SUBJECT is a mailto: address or an https:// URL that push services may contact.
POKEDND_VAPID_PUBLIC=CHANGE_ME
POKEDND_VAPID_PRIVATE=CHANGE_ME
POKEDND_VAPID_SUBJECT=mailto:admin@example.com

# Where skins, card art and export files live. This is a volume inside the container; leave as is.
POKEDND_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Optional test Minecraft server (profile "minecraft")
# ---------------------------------------------------------------------------

# Set to TRUE to accept the Minecraft EULA (https://aka.ms/MinecraftEULA). The server does not start otherwise.
MINECRAFT_EULA=FALSE
MINECRAFT_MEMORY=4G
